// NeuraMed - Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum PregnancyStatus {
  NOT_APPLICABLE
  PREGNANT
  BREASTFEEDING
  PLANNING
}

enum ReminderStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  PUSH
  ALARM
  BOTH
}

enum DoseLogStatus {
  TAKEN
  SKIPPED
  POSTPONED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum ReportType {
  LAB
  IMAGING
}

// ─── USER ─────────────────────────────────────────────────────────────────────

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String?         @unique
  phone            String?         @unique
  passwordHash     String?
  age              Int?
  gender           Gender?
  heightCm         Float?
  weightKg         Float?
  allergiesJson    String?         // JSON array of allergy strings (encrypted)
  chronicConditionsJson String?    // JSON array (encrypted)
  currentMedicationsJson String?   // JSON array (encrypted)
  pregnancyStatus  PregnancyStatus @default(NOT_APPLICABLE)
  emergencyContact String?         // encrypted JSON {name, phone}
  language         String          @default("uz")
  // Rol: "patient" (bemor) yoki "doctor" (shifokor)
  role             String          @default("patient")
  specialty        String?         // shifokor: mutaxassislik
  clinicName       String?         // shifokor: ish joyi
  licenseNo        String?         // shifokor: litsenziya raqami (demo: tekshirilmaydi)
  workDaysJson     String?         // shifokor: ish kunlari [1..6]
  workHoursJson    String?         // shifokor: [boshlanish, tugash] soat
  doctorRef        String?         // MEDCONNECT katalogidagi shifokor identifikatori
  notifReadAt      DateTime?       // bildirishnomalar oxirgi marta o'qilgan vaqt
  pushSubscriptionJson String?     // encrypted Web Push subscription
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  reminders        Reminder[]
  labReports       LabReport[]
  imagingReports   ImagingReport[]
  doctorVisitPreps DoctorVisitPrep[]
  sessions         Session[]
  appointments     Appointment[]
  doctorMessages   DoctorMessage[]
  traceReports     TraceReport[]
  healthCard       HealthCard?
  vitalReadings    VitalReading[]
  checkups         Checkup[]

  @@index([email])
  @@index([phone])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ─── MEDICATION ───────────────────────────────────────────────────────────────

model Medication {
  id               String     @id @default(cuid())
  name             String
  genericName      String?
  brandNames       String?    // JSON array
  form             String?    // tablet, capsule, syrup, injection, etc.
  rxcui            String?    @unique // RxNorm concept ID
  sourceProvider   String     @default("DailyMed") // DailyMed | openFDA
  sourceSetId      String?    // DailyMed SPL setid
  sourceUrl        String?
  lastUpdated      String?
  rawLabelJson     String?    // raw API response (JSON string)
  simplifiedInfoJson String?  // AI-simplified JSON (MedicationInfo type)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  reminders        Reminder[]

  @@index([name])
  @@index([rxcui])
}

// ─── REMINDER ─────────────────────────────────────────────────────────────────

model Reminder {
  id               String           @id @default(cuid())
  userId           String
  medicationId     String?
  medicationName   String           // display name (in case medication record deleted)
  dose             String           // "500 mg"
  timesPerDay      Int              @default(1)
  scheduleJson     String           // JSON array of times: ["08:00", "20:00"]
  foodRule         String?          // "ovqat bilan" | "bo'sh qorin" | "ahamiyatsiz"
  startDate        DateTime
  endDate          DateTime?
  status           ReminderStatus   @default(ACTIVE)
  notificationType NotificationType @default(PUSH)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication       Medication?      @relation(fields: [medicationId], references: [id])
  doseLogs         DoseLog[]

  @@index([userId, status])
}

model DoseLog {
  id         String        @id @default(cuid())
  reminderId String
  scheduledAt DateTime
  status     DoseLogStatus
  takenAt    DateTime?
  note       String?
  createdAt  DateTime      @default(now())

  reminder   Reminder      @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId])
  @@index([scheduledAt])
}

// ─── LAB REPORT ───────────────────────────────────────────────────────────────

model LabReport {
  id              String   @id @default(cuid())
  userId          String
  fileUrl         String?  // encrypted storage URL
  fileName        String?
  extractedText   String?  // OCR result
  parsedMarkersJson String? // JSON array of LabMarker
  aiExplanationJson String? // AI response JSON
  hasUrgentValues Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── IMAGING REPORT ───────────────────────────────────────────────────────────

model ImagingReport {
  id              String   @id @default(cuid())
  userId          String
  fileUrl         String?
  fileName        String?
  reportType      String?  // X-Ray, MRI, CT, Ultrasound, etc.
  extractedText   String?
  aiExplanationJson String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── DOCTOR VISIT PREP ────────────────────────────────────────────────────────

model DoctorVisitPrep {
  id              String       @id @default(cuid())
  userId          String
  symptomsJson    String       // JSON array of symptoms
  duration        String?      // "3 kun", "1 hafta"
  hasTemperature  Boolean?
  allergiesJson   String?
  currentMedsJson String?
  chronicCondJson String?
  pregnancyNote   String?
  aiResultJson    String?      // AI generated prep result
  appointmentId   String?      // qaysi qabulga tayyorlanish
  urgencyLevel    UrgencyLevel @default(LOW)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── MEDCONNECT (shifokor bilan aloqa) ────────────────────────────────────────
// Shifokorlar va muassasalar namunaviy (src/data/connect-data.js); qabul real emas.

model Appointment {
  id        String   @id @default(cuid())
  userId    String
  doctorId  String
  date      String   // YYYY-MM-DD
  time      String   // HH:MM
  name      String
  phone     String?
  reason    String?
  status    String   @default("pending") // pending | cancelled
  shareAccess Boolean @default(true)       // bemor shifokorga ma'lumotlarini ko'rishga ruxsat bergan
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DoctorMessage {
  id        String   @id @default(cuid())
  userId    String
  doctorId  String
  sender    String   // me | doctor (avtomatik demo javob)
  text      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, doctorId])
}

// ─── PHARMA TRACE ─────────────────────────────────────────────────────────────
// Mahsulotlar namunaviy (src/data/trace-data.js); foydalanuvchi xabarlari saqlanadi.

model TraceReport {
  id        String   @id @default(cuid())
  userId    String
  productId String
  reason    String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Salomatligim (AIVITA bilan taqqoslash natijasida qo'shilgan) ──────────────

/// QR tibbiy karta: qon guruhi, izoh va ochiq havola (egasi istalgan vaqtda o'chiradi)
model HealthCard {
  id           String   @id @default(cuid())
  userId       String   @unique
  bloodType    String?
  notes        String?  // encrypted
  shareToken   String?  @unique
  shareEnabled Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Ko'rsatkich o'lchovi (faqat shifokor kiritadi): puls, vazn, qand, harorat, SpO2, uyqu
model VitalReading {
  id        String   @id @default(cuid())
  userId    String
  type      String
  value     Float
  value2    Float?
  note      String?
  doctorRef  String?  // kiritgan shifokor
  doctorName String?
  at        DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// Chekap natijasi (Health Score)
model Checkup {
  id          String   @id @default(cuid())
  userId      String
  answersJson String
  score       Int
  scoresJson  String
  doctorRef   String?  // chekapni o'tkazgan shifokor
  doctorName  String?
  conclusion  String?  // shifokor xulosasi
  diagnosis   String?  // shifokor tashxisi
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Shifokorning saqlangan chekapga keyinroq qo'shgan izohi (bemorga bildirishnoma boradi)
model CheckupNote {
  id         String   @id @default(cuid())
  checkupId  String
  userId     String   // bemor
  doctorRef  String
  doctorName String
  text       String
  createdAt  DateTime @default(now())

  @@index([checkupId])
  @@index([userId])
}
