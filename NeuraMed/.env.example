# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/neuramed"

# Auth
AUTH_SECRET="change-this-to-random-32-char-string"
JWT_SECRET="change-this-to-random-32-char-string"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# VAPID (run: npm run vapid:generate)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@yourapp.uz"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage
STORAGE_PROVIDER="local"

# Encryption (32 bytes hex)
ENCRYPTION_KEY="change-this-to-64-hex-chars"

# APIs (all public, no keys required except openFDA for higher limits)
DAILYMED_API_BASE="https://dailymed.nlm.nih.gov/dailymed/services/v2"
OPENFDA_API_BASE="https://api.fda.gov/drug"
OPENFDA_API_KEY=""
RXNORM_API_BASE="https://rxnav.nlm.nih.gov/REST"
