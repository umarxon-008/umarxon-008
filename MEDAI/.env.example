# MEDAI server sozlamalari — bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env fayli Git'ga QO'SHILMAYDI (.gitignore). API kalitini hech qachon frontend kodiga yozmang.

# Server porti va manzili (0.0.0.0 — tarmoqdagi boshqa qurilmalardan kirish uchun)
PORT=3000
HOST=127.0.0.1

# Anthropic Claude API kaliti. Bo'sh qolsa — MEDAI xavfsiz DEMO rejimda ishlaydi (AI chaqirilmaydi).
# Kalit olish: https://platform.claude.com  (API pullik: ishlatilgan tokenlar bo'yicha)
ANTHROPIC_API_KEY=

# AI modeli. Arzonroq variantlar: claude-sonnet-5-5 (tavsiya etiladi), claude-haiku-5-5 (eng arzon)
MEDAI_MODEL=claude-opus-5-5

# true — kalit bo'lsa ham demo rejimni majburiy yoqish (test va taqdimot uchun)
MEDAI_FORCE_DEMO=false

# AI rad etganda server tomonida zaxira modelga o'tish (Opus 5.5 / Sonnet 5.5 da qo'llab-quvvatlanadi)
MEDAI_REFUSAL_FALLBACK=true

# Bir IP manzildan daqiqasiga ruxsat etilgan API so'rovlari soni
MEDAI_RATE_LIMIT=30

# Fayl hajmi chegarasi (MB). Standart: oddiy serverda 10, Netlify'da 4 (Netlify so'rovni ~6 MB bilan cheklaydi)
# MEDAI_MAX_FILE_MB=10
