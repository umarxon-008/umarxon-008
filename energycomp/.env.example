# PostgreSQL ulanishi (majburiy)
DATABASE_URL="postgresql://energycomp:energycomp@localhost:5432/energycomp"
# Integratsion testlar uchun alohida baza (npm test). Bo'lmasa integratsion testlar o'tkazib yuboriladi.
TEST_DATABASE_URL="postgresql://energycomp:energycomp@localhost:5432/energycomp_test"

# Ilovaning ochiq manzili (reset havolalari uchun)
APP_URL="http://localhost:3000"

# AI provider: "rule-based" (default, kalitsiz) yoki "anthropic"
AI_PROVIDER="rule-based"
# Faqat AI_PROVIDER=anthropic bo'lsa. Faqat serverda saqlanadi, client bundle'ga chiqmaydi.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# Demo telemetriya generatori (DEMO manbali uskunalar uchun). "false" — o'chiriladi.
DEMO_DATA_ENABLED="true"
